{
  "name": "hlhweb",
  "compatibility_date": "2026-07-16",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Run the Worker before serving static assets so the HTTP -> HTTPS
    // redirect in src/worker.ts applies to every request, including paths
    // that map directly to an asset (e.g. "/" -> index.html). Without this,
    // Cloudflare serves the matching asset first and the redirect is skipped.
    "run_worker_first": true
  }
}
